{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git pull --ff-only 2>&1 || echo \"SessionStart: git pull --ff-only did not fast-forward - the tree is dirty or the branch has diverged; reconcile by hand before working.\"",
            "timeout": 60,
            "statusMessage": "Pulling origin (fast-forward only)"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/attic-guard.sh\"",
            "timeout": 10,
            "statusMessage": "Checking the edit is not aimed at attic/"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/gated-test-reminder.sh\"",
            "timeout": 30,
            "statusMessage": "Checking gated-test obligations and running the cheap guards"
          }
        ]
      }
    ]
  }
}
