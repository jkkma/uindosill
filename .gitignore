# Build output
bin/
obj/
artifacts/
publish/
*.user
*.suo
*.userprefs

# Rider / VS / VS Code
.idea/
.vs/
.vscode/

# Test output
TestResults/
*.trx
coverage*.xml
*.coverage

# The vendored parakeet.cpp drop (see docs/NATIVE-BINARIES.md) is never committed: it is large,
# per-backend, and pinned to a specific upstream release.
#
# The whole directory is ignored rather than the binaries alone. Listing only *.dll/*.so/*.dylib
# was not equivalent: every `lib-` archive also carries LICENSE, README.md and parakeet_capi.h, so
# a vendoring left `native/` showing as untracked and invited someone to commit those by reflex.
# Nothing under native/ is authored here. Ignoring the LICENSE does not drop it from what ships —
# build/NativeAssets.targets copies it into the build output, which is where MIT needs it.
#
# Scoped to the root, like the audio patterns below: the drop lives at native/ and nowhere else, so
# a directory named native/ under tests/ stays visible instead of being swallowed by this rule.
/native/

# Model weights and downloaded audio fixtures never belong in the repo.
*.gguf
tests/fixtures/large/

# Measurement output. measure-transcribe.ps1 writes runs/<timestamp>-<backend>/ and
# measure-second-machine.ps1 writes runs/<machine>/<backend>/; a three-hour transcript is 4.4 MB
# of JSON on its own.
runs/

# The WER reference corpus, fetched by scripts/measure-wer.ps1 against the pins in
# scripts/wer-corpus.json: eleven hours of Earnings-22 audio and its human transcripts. The
# manifest is committed; the corpus is not — it is 120 MB, someone else's, and re-fetchable.
corpus/

# The audio this project is measured against lives in the repository root because that is where
# the harnesses expect it, and it is large. Scoped to the root so test fixtures are unaffected.
/*.m4a
/*.mp3
/*.mp4
/*.mkv
/*.wav
/*.flac
/*.wmv

# Transcripts from a bare `uindosill transcribe`, which writes beside its input rather than into
# runs/. Scoped to the root for the same reason. global.json is the only .json that belongs here.
/*.srt
/*.vtt
/*.txt
/*.json
!/global.json

# Not /*.md: README.md and NOTICE.md live here, so a `-f md` transcript written to the root has to
# be moved or deleted by hand. Use the harnesses, which write into runs/, and this does not arise.

# OS noise
.DS_Store
Thumbs.db

# Claude Code per-machine overrides; the shared hook lives in .claude/settings.json
.claude/settings.local.json
