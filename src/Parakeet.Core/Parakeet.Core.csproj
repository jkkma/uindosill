<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Parakeet.Core</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Parakeet.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The catalogue is data, not code, so pinning a digest is a reviewable data change.
         LogicalName is explicit: resource naming rules are not worth rediscovering. -->
    <EmbeddedResource Include="Models/models.json" LogicalName="Parakeet.Core.Models.models.json" />
  </ItemGroup>

  <!--
    Parakeet.Core references no engine, no platform and no UI. That seam is what keeps an
    engine swap to one project instead of a rewrite, so it is enforced by the build rather
    than by convention: adding a PackageReference here fails the build.

    If you think you need a package here, you almost certainly want an interface here and
    the package in the project that implements it.
  -->
  <Target Name="EnsureCoreHasNoPackageDependencies" BeforeTargets="Build">
    <Error Condition="'@(PackageReference)' != ''"
           Text="Parakeet.Core must have zero NuGet dependencies (found: @(PackageReference)). Put the dependency behind an interface in Core and implement it elsewhere." />
    <Error Condition="'@(ProjectReference)' != ''"
           Text="Parakeet.Core must not reference other projects (found: @(ProjectReference))." />
  </Target>

</Project>
