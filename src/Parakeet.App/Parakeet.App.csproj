<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Parakeet.App</RootNamespace>
    <AssemblyName>Uindosill</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsPublishableApp>true</IsPublishableApp>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>

    <!--
      The Velopack package id, and deliberately NOT "Uindosill".

      Velopack installs a Windows application under %LOCALAPPDATA%\<package id> and its uninstall
      deletes that directory recursively. This product's downloaded weights live in
      %LOCALAPPDATA%\Uindosill\models — 1.34 GiB for the transcription weights, 453 MiB for the
      diariser and 1.34 GiB for the translator, 3.12 GiB for all three — so an id of "Uindosill"
      would make uninstall delete every one of them. The id is a separate directory that shares no
      path segment with the data root, which is what keeps the two apart.

      Nothing user-facing carries this string: the installer's title, its shortcut and its
      Add/Remove Programs entry all come from VelopackPackageTitle below.

      One copy, two readers. scripts/package-windows.ps1 reads these with
      `dotnet msbuild -getProperty:`, and the AssemblyMetadata below puts the id in the assembly so
      PackagingIdentity — and the test that holds it against the models directory — reads the same
      value the installer was built with rather than a second literal.
    -->
    <VelopackPackageId>UindosillDesktop</VelopackPackageId>
    <VelopackPackageTitle>Uindosill</VelopackPackageTitle>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="VelopackPackageId" Value="$(VelopackPackageId)" />
  </ItemGroup>

  <!--
    The two typefaces the interface is drawn in, embedded rather than asked of the system.

    Both are SIL Open Font Licence 1.1, which is what makes shipping them inside the installer
    legal; their OFL texts are in licences/ and travel to the output like every other notice, and
    both have a row in Attribution.Components so `uindosill notice` names them.

    These are the *static* instances, not the variable fonts upstream also publishes. Avalonia's
    family grouping reads the typographic family name, and the static faces carry a legacy family
    name that disagrees with it — "Instrument Sans Medium" against "Instrument Sans" — so which
    name the toolkit groups by is the difference between one family with four weights and four
    families with one each. That is asserted rather than assumed, by
    TypographyTests.TheDesignsTypefacesAreEmbeddedAndResolveAtEveryWeightItDraws.

    Only the weights the design actually draws are here: 400/500/600/700 for the sans, 400/500 for
    the mono. About 313 KB in total.
  -->
  <ItemGroup>
    <AvaloniaResource Include="Assets/Fonts/*.ttf" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Velopack" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Parakeet.Core/Parakeet.Core.csproj" />
    <ProjectReference Include="../Parakeet.Audio/Parakeet.Audio.csproj" />
    <ProjectReference Include="../Parakeet.Engine.ParakeetCpp/Parakeet.Engine.ParakeetCpp.csproj" />
    <ProjectReference Include="../Parakeet.Engine.Python/Parakeet.Engine.Python.csproj" />
    <ProjectReference Include="../Parakeet.Engine.SileroVad/Parakeet.Engine.SileroVad.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Parakeet.App.Tests" />
  </ItemGroup>

  <Import Project="../../build/NativeAssets.targets" />
  <Import Project="../../build/Licences.targets" />

</Project>
