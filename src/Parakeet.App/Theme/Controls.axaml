<!--
  Control styling for the design decided 2026-08-19, and the reusable text classes the window
  draws with.

  Split from Tokens.axaml on a real distinction rather than for tidiness: that file overrides
  Fluent resource *keys*, which reach the whole application by name. This one handles the three
  things the design needs that have no key in Avalonia.Themes.Fluent 12.1.1 — the selected
  ListBoxItem background, and the ProgressBar's fill and track — plus the geometry and type roles
  that were never resource keys in any version. Searching the shipped assembly for
  ListBoxItemBackgroundSelected and ProgressBarForeground finds nothing, so an override written
  there would have loaded quietly and done nothing at all.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ── Type roles ──────────────────────────────────────────────────────────────────────────
       The design's six roles, as classes. Sizes and weights are the token sheet's.

       Body is 500 rather than 400, so it is set on TextBlock itself: a style setter loses to any
       local value, so a control that names its own weight still wins. Tabular figures are on for
       the same reason they are in the design — timestamps, durations and percentages are numbers
       you read rather than code, and they still have to align down a column. -->
  <Style Selector="TextBlock">
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    <Setter Property="FontFeatures" Value="+tnum" />
  </Style>

  <Style Selector="SelectableTextBlock">
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    <Setter Property="FontFeatures" Value="+tnum" />
  </Style>

  <!-- Tab page headings — Notices, Updates, the selected model. -->
  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="-0.255" />
  </Style>

  <!-- File names, model names. -->
  <Style Selector="TextBlock.emphasis">
    <Setter Property="FontWeight" Value="Bold" />
  </Style>

  <!-- OUTPUT FORMATS, IN MEMORY, LICENCE. -->
  <Style Selector="TextBlock.section">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="0.55" />
    <Setter Property="Foreground" Value="{DynamicResource InkSecondaryBrush}" />
  </Style>

  <!-- Status lines, sizes, hints. -->
  <Style Selector="TextBlock.meta">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource InkMetaBrush}" />
  </Style>

  <!-- The segment-cap note, warnings inside a row. -->
  <Style Selector="TextBlock.fine">
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="LineHeight" Value="16.3" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- Text you copy rather than read: paths, extensions, hex, licence notices. -->
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFamily}" />
  </Style>
  <Style Selector="SelectableTextBlock.mono">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFamily}" />
  </Style>

  <Style Selector="TextBlock.secondary">
    <Setter Property="Foreground" Value="{DynamicResource InkSecondaryBrush}" />
  </Style>

  <!-- The provenance line, which says whether an entry was checked. Amber is the unverified case
       only; a verified line reading "digest pinned" in amber draws a confirmation as a problem. -->
  <Style Selector="TextBlock.provenance">
    <Setter Property="Foreground" Value="{DynamicResource StatusWarningBrush}" />
  </Style>
  <Style Selector="TextBlock.provenance.verified">
    <Setter Property="Foreground" Value="{DynamicResource StatusVerifiedBrush}" />
  </Style>

  <Style Selector="TextBlock.warning">
    <Setter Property="Foreground" Value="{DynamicResource StatusWarningBrush}" />
  </Style>
  <Style Selector="TextBlock.error">
    <Setter Property="Foreground" Value="{DynamicResource StatusErrorBrush}" />
  </Style>

  <!-- ── Buttons ─────────────────────────────────────────────────────────────────────────────
       30px in a row, 32px standing on a page; square; a hairline rather than a fill. -->
  <Style Selector="Button">
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="13,0" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="{DynamicResource GroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
  </Style>

  <Style Selector="Button:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource GroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DisabledEdgeBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource DisabledTextBrush}" />
  </Style>

  <!-- The one filled button on a page: Start, Check now. -->
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource Matcha600Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Matcha600Brush}" />
    <Setter Property="Foreground" Value="{DynamicResource GroundBrush}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="Button.primary /template/ ContentPresenter">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource GroundBrush}" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Matcha700Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Matcha700Brush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource GroundBrush}" />
  </Style>
  <Style Selector="Button.primary:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource GroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DisabledEdgeBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource DisabledTextBrush}" />
  </Style>

  <Style Selector="Button.onPage">
    <Setter Property="Height" Value="32" />
  </Style>

  <!-- ── Fields ──────────────────────────────────────────────────────────────────────────────
       30px, square, a hairline that does not change the box. -->
  <Style Selector="TextBox">
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="NumericUpDown">
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="FontSize" Value="12.5" />
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!-- A disabled combo box dims; it does not fill.

       Fluent paints a disabled ComboBox with a solid grey ground, which is the only grey block
       anywhere in this window and reads as a filled field rather than an unavailable one. Every
       other disabled control here says so by going pale — see CheckBox:disabled below. The
       backend picker on the Models tab is disabled for as long as a model is loaded, which is
       most of the time anyone is looking at that tab, so this is not a rare state to get wrong.

       On the template's own border rather than through a resource key, which is the same reason
       the ListBoxItem selection below is done that way: the theme's pseudo-class styles set it
       there, so an override written as a resource compiles and does nothing. -->
  <Style Selector="ComboBox:disabled /template/ Border#Background">
    <Setter Property="Background" Value="{DynamicResource GroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RuleSeenBrush}" />
  </Style>
  <Style Selector="ComboBox:disabled">
    <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
  </Style>

  <!-- ── Checkbox ────────────────────────────────────────────────────────────────────────────
       17px and square. Fluent draws a 20px rounded box, so both are set on the template part. -->
  <Style Selector="CheckBox">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="MinHeight" Value="0" />
  </Style>
  <Style Selector="CheckBox /template/ Border#NormalRectangle">
    <Setter Property="Width" Value="17" />
    <Setter Property="Height" Value="17" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="BorderBrush" Value="{DynamicResource UncheckedBoxBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="CheckBox:checked /template/ Border#NormalRectangle">
    <Setter Property="Background" Value="{DynamicResource Matcha600Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Matcha600Brush}" />
  </Style>
  <Style Selector="CheckBox:disabled">
    <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
  </Style>

  <!-- ── List rows ───────────────────────────────────────────────────────────────────────────
       Square, 9px/10px padding, and the faintest possible "this one" when selected: matcha-50
       with a matcha-200 hairline. There is no ListBoxItemBackgroundSelected key in Fluent 12.1.1,
       so this is done on the template's presenter, where the theme's own pseudo-class styles put
       it. Writing it as a resource override would have compiled and done nothing. -->
  <Style Selector="ListBox">
    <Setter Property="Background" Value="{DynamicResource GroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RuleSeenBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="5" />
  </Style>

  <Style Selector="ListBoxItem">
    <Setter Property="Padding" Value="10,9" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>

  <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Matcha50Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Matcha200Brush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>

  <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Matcha50Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Matcha200Brush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Matcha50Brush}" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>

  <!-- ── Progress ────────────────────────────────────────────────────────────────────────────
       4px in a row, square, matcha-400 running on an #E9EBE5 track. Neither ProgressBarForeground
       nor a track key exists in Fluent 12.1.1; the default template binds both to the control's
       own Foreground and Background, so they are set there. -->
  <Style Selector="ProgressBar">
    <Setter Property="Height" Value="4" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource Matcha400Brush}" />
    <Setter Property="Background" Value="{DynamicResource ProgressTrackBrush}" />
  </Style>
  <Style Selector="ProgressBar /template/ Border#PART_Indicator">
    <Setter Property="CornerRadius" Value="0" />
  </Style>

  <!-- ── The pill view switcher ──────────────────────────────────────────────────────────────
       One of the four shapes that keeps a corner, and it keeps it because a pill reads as
       tappable. The segments are radio buttons rather than tab headers: the pages live in a
       TabControl whose own header strip is collapsed, so this is the only thing a user sees. -->
  <Style Selector="Border.switcher">
    <Setter Property="Background" Value="{DynamicResource SunkenBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RuleSeenBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="3" />
  </Style>

  <Style Selector="RadioButton.segment">
    <Setter Property="Padding" Value="15,5" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource InkSecondaryBrush}" />
    <Setter Property="LetterSpacing" Value="-0.0625" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="Pill"
                Background="Transparent"
                CornerRadius="999"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Name="PART_ContentPresenter"
                            Content="{TemplateBinding Content}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="RadioButton.segment:pointerover /template/ Border#Pill">
    <Setter Property="Background" Value="{DynamicResource Matcha50Brush}" />
  </Style>

  <Style Selector="RadioButton.segment:checked /template/ Border#Pill">
    <Setter Property="Background" Value="{DynamicResource Matcha100Brush}" />
  </Style>
  <Style Selector="RadioButton.segment:checked">
    <Setter Property="Foreground" Value="{DynamicResource Matcha700Brush}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>

  <!-- ── The pages behind the switcher ───────────────────────────────────────────────────────
       A TabControl still hosts and switches the pages; what it does not do is draw its own
       header strip, because the design puts the switcher in the headerbar where a tab strip
       cannot go. Collapsing the presenter rather than removing the TabControl keeps one selected
       index driving both, so the pills and the pages cannot disagree. -->
  <Style Selector="TabControl.headless">
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="TabControl.headless /template/ ItemsPresenter#PART_ItemsPresenter">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <!-- ── Window buttons ──────────────────────────────────────────────────────────────────────
       A bare glyph on no ground, which is what the maintainer asked for on 2026-08-20 in place of
       the 24px filled circles the design drew. The ground appears on hover and nowhere else, so
       the headerbar carries no chrome until somebody reaches for it.

       The button is much larger than the glyph on purpose. The circle used to be both the mark
       and the target; without it, sizing the button to the glyph would leave an 11px thing to
       hit. 46px wide and the full height of the bar is the target, and only the strokes are
       visible.

       Full height, and the headerbar drops its right padding to match, so the ground fills the
       corner instead of floating in it — the top-right pixel of the window belongs to Close, which
       is what makes it hittable by throwing the pointer at the corner.

       Close takes CloseHoverBrush rather than the error colour: same family, but chosen for a fill
       behind a white glyph rather than for small text on white. See Tokens.axaml. -->
  <Style Selector="Button.window">
    <Setter Property="Width" Value="46" />
    <!-- NaN, and it has to be said explicitly. The base Button style above sets Height="30" for
         buttons in a row of controls; Avalonia resolves competing styles by declaration order and
         each rule only overrides the properties it names, so leaving Height out left these 30px
         tall and centred in a 45px bar — flush to the right edge and floating below the top one.
         NaN is "auto", which is what lets VerticalAlignment="Stretch" actually stretch. -->
    <Setter Property="Height" Value="NaN" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <!-- Its own template, for the same reason RadioButton.segment has one. Setting the hover
         ground on Fluent's PART_ContentPresenter means competing with the Button ControlTheme's
         own :pointerover setter for that property on that element, and these buttons lost that
         argument and rendered no hover at all. A Border nothing else styles cannot lose it. -->
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="Ground" Background="Transparent">
          <ContentPresenter Content="{TemplateBinding Content}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <!-- The glyph's colour lives here rather than on the elements, so the close-hover rule below has
       something it can outrank. Written on the Path it was a local value, which beats every style
       setter no matter the selector, and the cross stayed ink-dark on the red. -->
  <Style Selector="Button.window Path">
    <Setter Property="Stroke" Value="{DynamicResource InkBrush}" />
  </Style>

  <!-- #ECEEE9 is the palette's "window button" grey, orphaned when the filled circles were
       dropped, and it is the right weight here: #EFF1EC is the rule you should only feel, which is
       too faint to be the only feedback a button gives. -->
  <Style Selector="Button.window:pointerover /template/ Border#Ground">
    <Setter Property="Background" Value="{DynamicResource WindowButtonBrush}" />
  </Style>
  <Style Selector="Button.window:pressed /template/ Border#Ground">
    <Setter Property="Background" Value="{DynamicResource RuleSeenBrush}" />
  </Style>

  <!-- Close is the exception that earns its colour: it is the only irreversible thing in the bar.
       CloseHoverBrush rather than the error colour — see Tokens.axaml for why the two differ. -->
  <Style Selector="Button.window.close:pointerover /template/ Border#Ground">
    <Setter Property="Background" Value="{DynamicResource CloseHoverBrush}" />
  </Style>
  <Style Selector="Button.window.close:pressed /template/ Border#Ground">
    <Setter Property="Background" Value="{DynamicResource CloseHoverBrush}" />
  </Style>
  <Style Selector="Button.window.close:pointerover Path">
    <Setter Property="Stroke" Value="{DynamicResource GroundBrush}" />
  </Style>

  <!-- ── Panels and badges ───────────────────────────────────────────────────────────────────
       Square, and bordered with a hairline. -->
  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource GroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RuleSeenBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>

  <Style Selector="Border.tinted">
    <Setter Property="Background" Value="{DynamicResource Matcha50Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Matcha200Brush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>

  <Style Selector="Border.badge">
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.badge TextBlock">
    <Setter Property="FontSize" Value="9" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="0.54" />
  </Style>

  <!-- Solid: what is in memory. Outlined: what a model does rather than what state it is in.
       The outline is what keeps speaker labelling inside the matcha family — it was #6B4E9C,
       which is taro's neighbourhood, and now that an Ask tab exists would read as a v2
       feature. -->
  <Style Selector="Border.badge.solid">
    <Setter Property="Background" Value="{DynamicResource Matcha600Brush}" />
  </Style>
  <Style Selector="Border.badge.solid TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource GroundBrush}" />
  </Style>
  <Style Selector="Border.badge.outlined">
    <Setter Property="BorderBrush" Value="{DynamicResource Matcha400Brush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.badge.outlined TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Matcha700Brush}" />
  </Style>

  <!-- Speaker labels: 6px, one of the chip shapes that keeps a corner. Eight styles — four in
       matcha, four in hues of their own; see the speaker-chips block below. The closed-set-of-four
       rationale retired with the ONNX diariser on 2026-08-27. -->
  <Style Selector="Border.speaker">
    <Setter Property="Padding" Value="10,3" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>
  <Style Selector="Border.speaker TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>

  <!-- A speaker's name, where it can be typed over. The base TextBox style is a 30px box with a
       hairline and 10px of side padding, which inside a 6px pill would be a box in a box; all three
       have to be named to be undone, because a style rule only overrides what it names.

       The chip keeps its own padding and its own colours, and the field inherits the ink from the
       chip class it is sitting in — so a renamed speaker is still visibly the same speaker. The
       caret has to be set beside each foreground: it does not follow it, and a matcha caret on a
       matcha ground is a field that looks like it is not focused. -->
  <Style Selector="Border.speaker TextBox">
    <Setter Property="Height" Value="NaN" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.speaker TextBox:focus">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Border.speaker TextBox:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <!-- ══ Speaker chips: four in matcha, then four in hues of their own ═══════════════════════
       Two fills then two outlines in matcha, and after them four light fills in the speaker hues
       Tokens.axaml admits for this one job. **Taro is still not borrowed** — it belongs to v2, and
       drawing it here would make speaker labelling look like a v2 feature.

       **The first four are untouched, and that is deliberate.** They are what one, two, three and
       four speakers have always rendered as, which is nearly every recording; extending the palette
       is not a reason to redraw the common case. The new hues begin where the old set ran out.

       **Four was not a design choice.** It was the ONNX diariser's architectural ceiling: a fifth
       speaker could not occur, so no fifth style was written. That engine was retired on 2026-08-27
       and the clustering pipeline that replaced it has no cap — AMI-style meetings routinely have
       five to seven — so the wrap at four stopped being unreachable and became a collision.

       **Why hues rather than four more matcha steps.** Matcha is one hue with six stops, and the
       two that would have been left differ by less than a chip's area can show: #5F793D against
       #4A602C is not a distinction anyone would name across a transcript. Rotating the hue at the
       same lightness and chroma is what the design already does for taro, so it is the move this
       system has a rule for.

       **Contrast is asserted rather than eyeballed.** `SpeakerChipContrastTests` reads these pairs
       out of this file, resolves them against Tokens.axaml, computes WCAG 2.1 contrast for every
       chip's text on its own background and fails below 4.5:1. A palette edit that darkens a
       foreground or lightens a fill is caught in CI rather than in a screenshot. -->
  <Style Selector="Border.speaker.chip0">
    <Setter Property="Background" Value="{DynamicResource Matcha600Brush}" />
  </Style>
  <Style Selector="Border.speaker.chip0 TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource GroundBrush}" />
  </Style>

  <Style Selector="Border.speaker.chip1">
    <Setter Property="Background" Value="{DynamicResource Matcha100Brush}" />
  </Style>
  <Style Selector="Border.speaker.chip1 TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Matcha700Brush}" />
  </Style>

  <Style Selector="Border.speaker.chip2">
    <Setter Property="BorderBrush" Value="{DynamicResource Matcha600Brush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.speaker.chip2 TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Matcha700Brush}" />
  </Style>

  <Style Selector="Border.speaker.chip3">
    <Setter Property="BorderBrush" Value="{DynamicResource Matcha400Brush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.speaker.chip3 TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Matcha600Brush}" />
  </Style>

  <!-- The speaker hues, all in chip1's treatment — a light fill with its own dark text — because
       that pairing is the most legible of the four above and there is no reason to spend the
       weaker ones on the speakers a reader meets last. -->
  <Style Selector="Border.speaker.chip4">
    <Setter Property="Background" Value="{DynamicResource Apricot100Brush}" />
  </Style>
  <Style Selector="Border.speaker.chip4 TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Apricot700Brush}" />
  </Style>

  <Style Selector="Border.speaker.chip5">
    <Setter Property="Background" Value="{DynamicResource Mint100Brush}" />
  </Style>
  <Style Selector="Border.speaker.chip5 TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Mint700Brush}" />
  </Style>

  <Style Selector="Border.speaker.chip6">
    <Setter Property="Background" Value="{DynamicResource Sky100Brush}" />
  </Style>
  <Style Selector="Border.speaker.chip6 TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Sky700Brush}" />
  </Style>

  <Style Selector="Border.speaker.chip7">
    <Setter Property="Background" Value="{DynamicResource Blossom100Brush}" />
  </Style>
  <Style Selector="Border.speaker.chip7 TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Blossom700Brush}" />
  </Style>

  <!-- ══ v2, and everything below this line is taro ═══════════════════════════════════════════
       The Ask tab's surfaces. They are separated from the styles above by colour alone — the
       geometry rules are the same ones — because that is the rule the design runs on: a surface's
       colour says which product generation it belongs to. Nothing above may use these, and
       nothing here may reach for matcha. -->

  <Style Selector="Border.tinted.taro">
    <Setter Property="Background" Value="{DynamicResource Taro50Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Taro200Brush}" />
  </Style>

  <!-- The chips: the third of the four shapes that keeps a corner, and it keeps it for the same
       reason the switcher pills do — a pill reads as tappable. Since 2026-08-24 most of them are:
       the suggestion chips ask their question, and an answer's citation chips seek the recording,
       which is why the Button variant exists beside the Border one. -->
  <Style Selector="Border.chip">
    <Setter Property="Background" Value="{DynamicResource Taro100Brush}" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="11,5" />
  </Style>
  <Style Selector="Border.chip TextBlock">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource Taro700Brush}" />
  </Style>
  <Style Selector="Button.chip">
    <Setter Property="Background" Value="{DynamicResource Taro100Brush}" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="11,5" />
    <Setter Property="Height" Value="NaN" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource Taro700Brush}" />
  </Style>
  <Style Selector="Button.chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Taro200Brush}" />
  </Style>

  <!-- The transport's play button, which is one of the things in this design that is genuinely a
       circle rather than a rounded rectangle. A template of its own rather than a CornerRadius on
       the standard button, because the standard button's hairline edge has no place on it. -->
  <Style Selector="Button.transport">
    <Setter Property="Width" Value="38" />
    <Setter Property="Height" Value="38" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="Ground" Background="{DynamicResource Taro600Brush}" CornerRadius="999">
          <ContentPresenter Name="PART_ContentPresenter"
                            Content="{TemplateBinding Content}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.transport:pointerover /template/ Border#Ground">
    <Setter Property="Background" Value="{DynamicResource Taro700Brush}" />
  </Style>
  <!-- Disabled in the family's own colours rather than the theme's grey: the button sits on the
       taro-tinted transport strip, and a grey disc there reads as dirt on the design rather than
       as a state of it. A pale taro ground with a taro glyph is unmistakably not pressable and
       still belongs to the strip it sits on. -->
  <Style Selector="Button.transport:disabled /template/ Border#Ground">
    <Setter Property="Background" Value="{DynamicResource Taro100Brush}" />
  </Style>

  <!-- The presenter inside the circle, stripped of the grounds other rules give it. The
       window-wide Button:disabled style at the top of this file paints every disabled button's
       ContentPresenter in GroundBrush — right for the standard button, whose whole face that
       presenter is, and here it drew a white square behind the glyph in the middle of the
       disabled disc. Fluent's own ControlTheme does the same on hover and press. Each state is
       named in full because a rule only overrides the properties it names, and these come after
       the window-wide one so they win the declaration-order tie. -->
  <Style Selector="Button.transport /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.transport:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.transport:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.transport:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>

  <!-- The glyph's colour runs along its edge as well as filling it, with round joins: a filled
       polygon alone has needle corners, which anti-alias to fuzz at 13px, and the stroke is what
       gives the triangle and the bars their soft corners. The stroke has to be recoloured beside
       the fill in the disabled state, because it does not follow it. -->
  <Style Selector="Button.transport Path">
    <Setter Property="Fill" Value="{DynamicResource GroundBrush}" />
    <Setter Property="Stroke" Value="{DynamicResource GroundBrush}" />
    <Setter Property="StrokeThickness" Value="2" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="StrokeLineCap" Value="Round" />
  </Style>
  <Style Selector="Button.transport:disabled Path">
    <Setter Property="Fill" Value="{DynamicResource Taro400Brush}" />
    <Setter Property="Stroke" Value="{DynamicResource Taro400Brush}" />
  </Style>

  <!-- The recordings drawer's button. A toggle rather than a Button, because open and shut are
       its two states and the checked face says which is on; the same 30px square hairline as
       every button standing in a row, checked in taro because the drawer belongs to the Ask tab.
       Fluent rounds a ToggleButton's corner and paints its checked state in the accent, so both
       are overridden on the template part the theme itself styles. -->
  <Style Selector="ToggleButton.drawer">
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="13,0" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="{DynamicResource GroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
  </Style>
  <Style Selector="ToggleButton.drawer:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Taro50Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Taro200Brush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource InkBrush}" />
  </Style>
  <Style Selector="ToggleButton.drawer:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Taro100Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Taro200Brush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Taro700Brush}" />
  </Style>
  <Style Selector="ToggleButton.drawer:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Taro100Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Taro200Brush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Taro700Brush}" />
  </Style>

  <!-- The played part of the recording. A ProgressBar rather than a Slider, and that is a
       decision: Fluent's slider is themed through template parts whose names are its own, and
       this file's opening note is about exactly that failure — a selector that matches nothing
       loads without complaint and changes nothing. A bar plus a transparent strip that takes the
       pointer is two things whose behaviour is visible from here.

       That arrangement was once thought to cost the design's circular seek handle, "which cannot
       be positioned without a measured width". The premise was wrong rather than the conclusion:
       no *binding* can measure a width, but the transparent strip has been measuring one since the
       day it was written — that is how a press at an x becomes a fraction of the recording. The
       handle below runs the same arithmetic in the other direction. -->
  <Style Selector="ProgressBar.seek">
    <Setter Property="Height" Value="6" />
    <Setter Property="Foreground" Value="{DynamicResource Taro600Brush}" />
    <Setter Property="Background" Value="{DynamicResource ProgressTrackBrush}" />
  </Style>

  <!-- The handle on that bar. One of the shapes that is genuinely a circle, so a radius of half
       its size rather than the design's 0px corner: this is a control you drag, and the whole of
       the affordance is that it does not look like the square surfaces around it.

       Its ground is the window's rather than taro, with a taro edge, so it reads as a bead sitting
       on the bar at any position — over the played part, over the unplayed part, or on the seam
       between them, which is exactly where it spends its whole life. A solid taro puck vanishes
       into the played bar behind it. -->
  <Style Selector="Border.puck">
    <Setter Property="Width" Value="13" />
    <Setter Property="Height" Value="13" />
    <Setter Property="CornerRadius" Value="6.5" />
    <Setter Property="Background" Value="{DynamicResource GroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Taro600Brush}" />
    <Setter Property="BorderThickness" Value="3" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>

  <!-- One segment of the transcript, in the tab where a segment is a place in the recording
       rather than a paragraph. A Button rather than a Border with a pointer handler, so the
       keyboard reaches it and the seek is a command like every other action in this window. -->
  <Style Selector="Button.cue">
    <!-- NaN and a zeroed minimum, for the same reason Button.window above says it in full: the base
         Button style sets Height="30" for a button standing in a row of controls, and each rule
         overrides only the properties it names. A cue is not that kind of button — it is a
         paragraph, and its height is however many lines the words take at the width the window
         happens to be.

         Left at 30 it was the defect this tab shipped with. Thirty less twelve of padding is
         eighteen, and eighteen was handed down to both halves of the cue: the words were laid out
         against it and TextWrapping="Wrap" kept the one line that fitted and dropped the rest, so a
         paragraph arrived cut off mid-sentence; and the speaker chip's label got 18 - 3 - 3 = 12 for
         text that lays out at 14.64, which sliced the bottom off every name. One height, two defects
         that looked unrelated. Measured before and after — see the three tests named on the cue's
         Grid in MainWindow.axaml. -->
    <Setter Property="Height" Value="NaN" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="5,6,8,6" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <ControlTemplate>
        <!-- The 3px left edge is always there and usually invisible. Drawn transparent rather than
             added when a line becomes the current search hit, because a border that appears moves
             the words 3px to the right, and stepping through hits would jog every line it touched. -->
        <Border Name="Ground" Background="Transparent"
                BorderBrush="Transparent" BorderThickness="3,0,0,0"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Name="PART_ContentPresenter"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalAlignment="Stretch" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.cue:pointerover /template/ Border#Ground">
    <Setter Property="Background" Value="{DynamicResource Taro50Brush}" />
  </Style>
  <Style Selector="Button.cue.playing /template/ Border#Ground">
    <Setter Property="Background" Value="{DynamicResource Taro100Brush}" />
  </Style>

  <!-- The hit the search is standing on. An edge rather than a second ground, because the ground
       is already spoken for by playback and the two states are independent — the line being played
       can also be the line being looked at, and one of them would otherwise have to lose. -->
  <Style Selector="Button.cue.found /template/ Border#Ground">
    <Setter Property="BorderBrush" Value="{DynamicResource Taro600Brush}" />
  </Style>

  <!-- The same badge as the two above, in v2's colours. Solid rather than outlined, because what
       it says is a state — this is not finished — rather than a capability. -->
  <Style Selector="Border.badge.taro">
    <Setter Property="Background" Value="{DynamicResource Taro600Brush}" />
  </Style>
  <Style Selector="Border.badge.taro TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource GroundBrush}" />
  </Style>

  <!-- The scrim over the chat panel. Not a grey wash: it is the panel's own ground at 82%, so what
       is underneath reads as present-but-not-yet rather than as switched off. -->
  <Style Selector="Border.wip">
    <Setter Property="Background" Value="#D1F7F3FE" />
  </Style>

  <!-- ── The edge that moves ─────────────────────────────────────────────────────────────────
       The splitter between the picture and the transcript on the Ask tab. Fluent's own theme for
       one is a minimum size and a bare Border with nothing named inside it, so a selector reaching
       into that template would match nothing and — per this file's opening note — say so by
       staying silent. The template is replaced rather than adjusted.

       What it draws is the hairline this design already puts between surfaces, with a short grip
       lying on it. A rule on its own reads as an edge; an edge that can be moved has to say so
       before anyone tries. Ten units tall over a one-unit line, so the target is a comfortable one.

       No Cursor set here: the control chooses its own from its resize direction.

       Taro because this edge belongs to the Ask tab, which is the generation rule this window
       runs on — and Taro200 at rest with Taro400 on hover are both fills rather than text, which
       is all Taro400 is legal for.

       Only the splitter that carries this class. The three bare ones elsewhere in the window are
       deliberately left invisible: they separate columns that were already sized, and nothing has
       asked for those to move. -->
  <Style Selector="GridSplitter.handle">
    <Setter Property="Height" Value="10" />
    <!-- Transparent rather than left unset. A null Background is not hit-testable, which is why
         every splitter in this window already names one. -->
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="Ground" Background="{TemplateBinding Background}">
          <Panel>
            <Border Name="Rule" Height="1" VerticalAlignment="Center"
                    Background="{DynamicResource RuleSeenBrush}" />
            <Border Name="Grip" Width="34" Height="3"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource Taro200Brush}" />
          </Panel>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="GridSplitter.handle:pointerover /template/ Border#Grip">
    <Setter Property="Background" Value="{DynamicResource Taro400Brush}" />
  </Style>

  <!-- ── Separator ───────────────────────────────────────────────────────────────────────── -->
  <Style Selector="Separator">
    <Setter Property="Background" Value="{DynamicResource RuleSeenBrush}" />
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="0" />
  </Style>

</Styles>
