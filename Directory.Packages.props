<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- UI. Avalonia 12.1.1 published 2026-07-29; plain net10.0 TFM on Windows, so the
         desktop app cross-builds from Linux CI. Avalonia.Diagnostics is deliberately
         absent: it has no 12.x release (latest is 11.3.20) and referencing it would
         downgrade the Avalonia graph. -->
    <PackageVersion Include="Avalonia" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Headless" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Headless.XUnit" Version="12.1.1" />

    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />

    <!-- Packaging and update. 1.2.0 is the latest stable on nuget.org for both this package and the
         vpk CLI that builds the installer (re-checked 2026-08-18); 1.2.110-ge826545 is a CI
         prerelease, not a release. The two versions must agree — see scripts/package-windows.ps1,
         which reads this file rather than carrying a second copy of the number. -->
    <PackageVersion Include="Velopack" Version="1.2.0" />

    <!-- NAudio 2.3.0 is the last stable line. 3.0 is preview-only with no GA date.
         The NAudio metapackage is deliberately NOT used: it drags in NAudio.WinForms, whose
         FrameworkReference on Microsoft.WindowsDesktop.App.WindowsForms cannot be resolved on a
         Linux SDK, which would end cross-building the Windows target from CI. Media Foundation
         lives in NAudio.Wasapi; NAudio.Core carries the sample-provider extensions. -->
    <PackageVersion Include="NAudio.Wasapi" Version="2.3.0" />
    <PackageVersion Include="NAudio.Core" Version="2.3.0" />

    <!-- Speaker diarisation. Microsoft.ML.OnnxRuntime carries only natives and pulls
         Microsoft.ML.OnnxRuntime.Managed for the C# API, so one reference gets both. 1.29.0 is
         built from the same source commit (2e2543f) as the Python onnxruntime 1.29 the diarisation
         spike measured on, so the graph this runs is the graph that was scored, not a later one.
         It is a single package carrying natives for every RID — win-x64 among them — which is why
         `dotnet publish -r win-x64` still cross-builds from Linux CI.

         MIT, plus a 343 KB ThirdPartyNotices.txt covering 69 bundled components; both ship, see
         docs/LICENSING.md. Do not call OrtValue's System.Numerics.Tensors members: that package
         marks TensorSpan<T> and friends [Experimental], which is an error under
         TreatWarningsAsErrors. The plain Span<T> siblings are the ones to use. -->
    <PackageVersion Include="Microsoft.ML.OnnxRuntime" Version="1.29.0" />

    <!-- Avalonia.Headless.XUnit 12.x requires xUnit v3, not v2. -->
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
  </ItemGroup>

</Project>
